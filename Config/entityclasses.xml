	<append xpath="/entity_classes/entity_class[@name='zombieBusinessMan']">
		<drop event="Harvest" name="clothingOutfitT1" tag="butcherHarvest" count="1" prob="0.14"/>
		<drop event="Harvest" name="oldCash" tag="butcherHarvest" count="25" prob="0.30"/>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombiePartyGirl']">
		<drop event="Harvest" name="clothingOutfitT1" tag="butcherHarvest" count="1" prob="0.14"/>
		<drop event="Harvest" name="resourceCloth" tag="butcherHarvest" count="5" prob="0.45"/>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieSkateboarder']">
		<drop event="Harvest" name="clothingOutfitT1" tag="butcherHarvest" count="1" prob="0.12"/>
		<drop event="Harvest" name="resourceCloth" tag="butcherHarvest" count="4" prob="0.40"/>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieInmate']">
		<drop event="Harvest" name="clothingOutfitT1" tag="butcherHarvest" count="1" prob="0.10"/>
		<drop event="Harvest" name="resourceCloth" tag="butcherHarvest" count="5" prob="0.50"/>
	</append>
	<append xpath="/entity_classes/entity_class[@name='zombieFatHawaiian']">
		<drop event="Harvest" name="clothingOutfitT1" tag="butcherHarvest" count="1" prob="0.10"/>
		<drop event="Harvest" name="resourceCloth" tag="butcherHarvest" count="4" prob="0.40"/>
	</append>
</configs>
